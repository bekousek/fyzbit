{
  "name": "fyzbit",
  "version": "0.1.0",
  "description": "FyzBit — webový datalogger pro micro:bit s fyzikálními senzory (ZŠ/SŠ)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,css,json,html}\" \"tests/**/*.ts\" \"*.{json,html,md,ts}\"",
    "firmware": "node scripts/build-firmware.mjs"
  },
  "keywords": [
    "microbit",
    "physics",
    "datalogger",
    "education",
    "fyzika"
  ],
  "author": "Ondřej Bek",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://bekousek.github.io/fyzbit",
  "repository": {
    "type": "git",
    "url": "https://github.com/bekousek/fyzbit.git"
  },
  "dependencies": {
    "@microbit/microbit-connection": "^1.0.0",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "uplot": "^1.6.31"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
